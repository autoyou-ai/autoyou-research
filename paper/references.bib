@misc{autoyou2026measure,
  author = {{AutoYou Research}},
  title  = {Primary measurement harness and raw per-run records for single-stream local inference},
  year   = {2026},
  note   = {Measured 2026-09-05 on two consumer machines under Windows 11 with
            Ollama 0.33: an AMD Ryzen AI MAX+ 395 ``Strix Halo'' (Radeon 8060S,
            64 GB unified LPDDR5X-8000, 256 GB/s specified) and an NVIDIA
            GeForce RTX 5070 (12 GB GDDR7, 672 GB/s specified, driver 610.47).
            Protocol: temperature 0, seed 20260905, context 4096, warm-up
            discarded, median over repetitions with the full spread retained,
            chat template bypassed and a per-repetition salt at position zero
            to defeat both prompt-cache paths, prompt length swept over four
            values per model with prefill time regressed on prompt tokens.
            Board power is sampled on the NVIDIA part only; the AMD part
            exposes no rail readable without a kernel-mode helper the harness
            declines to install. The harness and the raw per-run records,
            including every power trace, are released with this study under an
            MIT licence. Accessed 2026-09-06},
  urldate = {2026-09-14},
  url    = {https://github.com/autoyou-ai/autoyou-research}
}

